{"dur":35.1,"ev":[{"t":4.02,"type":"slide"},{"t":10.18,"type":"whoosh"},{"t":14.9,"type":"burst"},{"t":18.74,"type":"walkie"},{"t":23.22,"type":"eject"},{"t":23.7,"type":"slide"},{"t":26.02,"type":"stamp"},{"t":29.03,"type":"taps"},{"t":29.36,"type":"whoosh"},{"t":31.39,"type":"clunk"},{"t":0,"type":"cap","t1":0.98,"text":"Police heard this bank"},{"t":0.98,"type":"cap","t1":2.59,"text":"robbery happening live,"},{"t":2.59,"type":"cap","t1":3.28,"text":"and still couldn't"},{"t":3.28,"type":"cap","t1":3.95,"text":"stop it."},{"t":4.58,"type":"cap","t1":6.1,"text":"In 1971,"},{"t":6.1,"type":"cap","t1":6.78,"text":"a gang rented"},{"t":6.78,"type":"cap","t1":7.74,"text":"a shop two doors"},{"t":7.74,"type":"cap","t1":8.66,"text":"from a Lloyds bank"},{"t":8.66,"type":"cap","t1":9.48,"text":"on Baker Street"},{"t":9.48,"type":"cap","t1":10.3,"text":"in London."},{"t":10.76,"type":"cap","t1":11.2,"text":"They dug a"},{"t":11.2,"type":"cap","t1":12.02,"text":"40 ft tunnel"},{"t":12.02,"type":"cap","t1":12.86,"text":"under the restaurant"},{"t":12.86,"type":"cap","t1":13.76,"text":"in between,"},{"t":13.76,"type":"cap","t1":15.1,"text":"straight into the vault."},{"t":15.94,"type":"cap","t1":16.24,"text":"A lookout"},{"t":16.24,"type":"cap","t1":17.04,"text":"on a rooftop"},{"t":17.04,"type":"cap","t1":17.7,"text":"talked to them"},{"t":17.7,"type":"cap","t1":18.95,"text":"by walkie-talkie."},{"t":19.56,"type":"cap","t1":20.52,"text":"Half a mile away,"},{"t":20.52,"type":"cap","t1":21.16,"text":"Robert Rowlands"},{"t":21.16,"type":"cap","t1":22.55,"text":"picked up every word,"},{"t":22.55,"type":"cap","t1":23.45,"text":"and taped it."},{"t":24.14,"type":"cap","t1":24.6,"text":"But the tapes"},{"t":24.6,"type":"cap","t1":26.25,"text":"never named the bank."},{"t":26.78,"type":"cap","t1":27.42,"text":"Police checked"},{"t":27.42,"type":"cap","t1":29.25,"text":"750 of them."},{"t":29.7,"type":"cap","t1":30.14,"text":"By the time"},{"t":30.14,"type":"cap","t1":30.6,"text":"they found"},{"t":30.6,"type":"cap","t1":31.7,"text":"the right one,"},{"t":31.7,"type":"cap","t1":34.12,"text":"268 safe deposit boxes"},{"t":34.12,"type":"cap","t1":35.1,"text":"had been emptied."},{"t":2.28,"type":"gap","t1":2.59},{"t":3.76,"type":"gap","t1":4.58},{"t":10.11,"type":"gap","t1":10.78},{"t":13.58,"type":"gap","t1":13.77},{"t":14.87,"type":"gap","t1":15.96},{"t":18.69,"type":"gap","t1":19.58},{"t":22.34,"type":"gap","t1":22.57},{"t":23.18,"type":"gap","t1":24.16},{"t":25.96,"type":"gap","t1":26.79},{"t":28.99,"type":"gap","t1":29.72},{"t":31.37,"type":"gap","t1":31.7},{"t":31.37,"type":"musicstop"}]}