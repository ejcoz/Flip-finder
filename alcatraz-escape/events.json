{"dur":33.65,"ev":[{"t":0,"type":"amb_island","d":1},{"t":4.72,"type":"whoosh"},{"t":4.98,"type":"clank"},{"t":12.45,"type":"whoosh"},{"t":12.62,"type":"step","v":1},{"t":12.86,"type":"step","v":0.8},{"t":13.09,"type":"step","v":0.6},{"t":16.7,"type":"whoosh","v":0.6},{"t":16.8,"type":"step","v":0.3},{"t":16.98,"type":"step","v":0.22},{"t":21.9,"type":"click"},{"t":21.95,"type":"whoosh"},{"t":22.05,"type":"wind","d":1.1},{"t":27.82,"type":"splash"},{"t":30,"type":"thunk"},{"t":30.05,"type":"whoosh","v":0.5},{"t":30.18,"type":"paper"},{"t":30.5,"type":"stamp"},{"t":1,"type":"cap","t1":2.04,"text":"Three men broke out"},{"t":2.04,"type":"cap","t1":3.2,"text":"of Alcatraz,"},{"t":3.2,"type":"cap","t1":3.82,"text":"and nobody has"},{"t":3.82,"type":"cap","t1":5.1,"text":"found them since."},{"t":5.54,"type":"cap","t1":7.04,"text":"In 1962,"},{"t":7.24,"type":"cap","t1":7.74,"text":"Frank Morris"},{"t":7.74,"type":"cap","t1":8.84,"text":"and the Anglin brothers"},{"t":8.84,"type":"cap","t1":9.62,"text":"drilled through"},{"t":9.62,"type":"cap","t1":10.46,"text":"their cell walls"},{"t":10.46,"type":"cap","t1":11.32,"text":"with a drill made"},{"t":11.32,"type":"cap","t1":12.92,"text":"from a vacuum motor."},{"t":13.2,"type":"cap","t1":13.88,"text":"A fourth man"},{"t":13.88,"type":"cap","t1":14.92,"text":"was meant to go,"},{"t":14.92,"type":"cap","t1":15.54,"text":"but his vent"},{"t":15.54,"type":"cap","t1":17.1,"text":"wouldn't open in time,"},{"t":17.1,"type":"cap","t1":17.92,"text":"so the other three"},{"t":17.92,"type":"cap","t1":18.9,"text":"went without him,"},{"t":18.9,"type":"cap","t1":19.82,"text":"leaving fake heads"},{"t":19.82,"type":"cap","t1":21,"text":"with real human hair"},{"t":21,"type":"cap","t1":22.24,"text":"in their beds."},{"t":23.19,"type":"cap","t1":24,"text":"They crossed the roof"},{"t":24,"type":"cap","t1":24.6,"text":"to the shore"},{"t":24.6,"type":"cap","t1":25.9,"text":"and launched a raft"},{"t":25.9,"type":"cap","t1":26.74,"text":"made from over"},{"t":26.74,"type":"cap","t1":28.24,"text":"50 raincoats."},{"t":28.41,"type":"cap","t1":29.08,"text":"The guards found"},{"t":29.08,"type":"cap","t1":30.4,"text":"only the heads."},{"t":30.96,"type":"cap","t1":32.02,"text":"The U.S. Marshals"},{"t":32.02,"type":"cap","t1":32.88,"text":"have never closed"},{"t":32.88,"type":"cap","t1":33.65,"text":"the case."}]}